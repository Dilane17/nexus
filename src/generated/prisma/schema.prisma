generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName        String        @db.VarChar(150)
  lastName         String        @db.VarChar(150)
  phone            String        @unique @db.VarChar(20)
  email            String?       @unique @db.VarChar(200)
  city             String? // ex: "Cotonou"
  district         String? // ex: "Cadjehoun"
  googleId         String?       @unique // pour OAuth Google
  avatar           String? // photo de profil Google
  status           user_status   @default(PENDING)
  // OTP
  otpCode          String? // code 5 chiffres hashé bcrypt
  otpExpiry        DateTime? // expiration dans 5 minutes
  otpType          String? // 'PHONE_VERIFICATION' | 'EMAIL_VERIFICATION'
  isPhoneVerified  Boolean       @default(false)
  isEmailVerified  Boolean       @default(false)
  kyc_status       kyc_status    @default(NOT_STARTED)
  kyc_document_url String?       @db.VarChar(500)
  created_at       DateTime      @default(now()) @db.Timestamp(6)
  last_login       DateTime?     @db.Timestamp(6)
  admin            Admin?
  agent            Agent?
  borrower         Borrower?
  imfStaff         ImfStaff?
  investor         Investor?
  transactions     Transaction[]
  password         String? //mot de pass haché bcrypt
  refresh_token    String? //token de rafraîchissement pour les sessions

  @@index([kyc_status], map: "idx_users_kyc_status")
  @@index([phone], map: "idx_users_phone")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model Investor {
  id                    String                 @id @db.Uuid
  wallet_balance        Decimal                @default(0.00) @db.Decimal(15, 2)
  total_invested        Decimal                @default(0.00) @db.Decimal(15, 2)
  total_returns         Decimal                @default(0.00) @db.Decimal(15, 2)
  risk_profile          risk_profile           @default(BALANCED)
  investor_type         investor_type          @default(RETAIL)
  institutionalInvestor InstitutionalInvestor?
  investments           Investment[]
  user                  User                   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  retailInvestor        RetailInvestor?

  @@map("investors")
}

model RetailInvestor {
  id                 String   @id @db.Uuid
  max_investment_cap Decimal  @default(5000000.00) @db.Decimal(15, 2)
  preferred_sectors  String[]
  investor           Investor @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("retail_investors")
}

model InstitutionalInvestor {
  id                 String   @id @db.Uuid
  organization_name  String   @db.VarChar(200)
  regulatory_license String   @db.VarChar(100)
  max_exposure_ratio Decimal  @default(0.3000) @db.Decimal(5, 4)
  investor           Investor @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("institutional_investors")
}

model Borrower {
  id                  String          @id @db.Uuid
  credit_score        Decimal         @default(0.00) @db.Decimal(5, 2)
  tontine_score       Decimal         @default(0.00) @db.Decimal(5, 2)
  mobile_money_number String          @unique @db.VarChar(20)
  momo_provider       momo_provider
  has_tontine_history Boolean         @default(false)
  default_count       Int             @default(0)
  borrower_scores     BorrowerScore[]
  user                User            @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  loans               Loan[]
  tontine_cycles      TontineCycle[]
  tontine_groups      TontineGroup[]
  tontine_members     TontineMember[]

  @@index([credit_score], map: "idx_borrowers_credit_score")
  @@map("borrowers")
}

model Admin {
  id          String     @id @db.Uuid
  role        admin_role @default(SUPPORT)
  permissions String[]   @default([])
  user        User       @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admins")
}

model Agent {
  id               String  @id @db.Uuid
  zone             String  @db.VarChar(100)
  agency_code      String  @unique @db.VarChar(20)
  commission_rate  Decimal @default(0.005) @db.Decimal(4, 3)
  clients_assisted Int     @default(0)
  user             User    @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("agents")
}

model ImfStaff {
  id                  String @id @db.Uuid
  imf_name            String @db.VarChar(200)
  license_number      String @unique @db.VarChar(100)
  bceao_agreement_ref String @db.VarChar(100)
  user                User   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  loans               Loan[]

  @@map("imf_staff")
}

model EscrowWallet {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  total_balance         Decimal   @default(0.00) @db.Decimal(15, 2)
  investor_funds        Decimal   @default(0.00) @db.Decimal(15, 2)
  pending_disbursements Decimal   @default(0.00) @db.Decimal(15, 2)
  locked_for_guarantee  Decimal   @default(0.00) @db.Decimal(15, 2)
  platform_fees         Decimal   @default(0.00) @db.Decimal(15, 2)
  third_party_manager   String    @db.VarChar(200)
  last_audit_date       DateTime? @db.Date

  @@map("escrow_wallet")
}

model PlatformWallet {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commission_balance   Decimal   @default(0.00) @db.Decimal(15, 2)
  operating_funds      Decimal   @default(0.00) @db.Decimal(15, 2)
  last_withdrawal_date DateTime? @db.Timestamp(6)

  @@map("platform_wallet")
}

model Loan {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  borrower_id         String       @db.Uuid
  amount              Decimal      @db.Decimal(15, 2)
  interest_rate       Decimal      @db.Decimal(5, 4)
  duration_months     Int
  status              loan_status  @default(PENDING_IMF)
  monthly_installment Decimal      @db.Decimal(15, 2)
  outstanding_balance Decimal      @db.Decimal(15, 2)
  days_overdue        Int          @default(0)
  validated_by_imf    Boolean      @default(false)
  disbursed_at        DateTime?    @db.Timestamp(6)
  next_due_date       DateTime?    @db.Date
  imf_validated_by    String?      @db.Uuid
  investments         Investment[]
  borrowers           Borrower     @relation(fields: [borrower_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  imf_staff           ImfStaff?    @relation(fields: [imf_validated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([borrower_id], map: "idx_loans_borrower_id")
  @@index([days_overdue], map: "idx_loans_days_overdue")
  @@index([status], map: "idx_loans_status")
  @@map("loans")
}

model Investment {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  investor_id                String                    @db.Uuid
  loan_id                    String                    @db.Uuid
  amount                     Decimal                   @db.Decimal(15, 2)
  expected_return            Decimal                   @db.Decimal(15, 2)
  actual_return              Decimal                   @default(0.00) @db.Decimal(15, 2)
  status                     investment_status         @default(ACTIVE)
  is_guaranteed              Boolean                   @default(true)
  guarantee_tier             Int                       @default(1)
  maturity_date              DateTime                  @db.Date
  guarantee_fund_investments GuaranteeFundInvestment[]
  investors                  Investor                  @relation(fields: [investor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loans                      Loan                      @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([investor_id], map: "idx_investments_investor_id")
  @@index([loan_id], map: "idx_investments_loan_id")
  @@index([status], map: "idx_investments_status")
  @@map("investments")
}

model Transaction {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           transaction_type
  amount         Decimal            @db.Decimal(15, 2)
  status         transaction_status @default(PENDING)
  momo_reference String?            @unique @db.VarChar(100)
  momo_provider  momo_provider?
  initiated_at   DateTime           @default(now()) @db.Timestamp(6)
  confirmed_at   DateTime?          @db.Timestamp(6)
  reconciled_at  DateTime?          @db.Timestamp(6)
  is_reconciled  Boolean            @default(false)
  failure_reason String?            @db.VarChar(300)
  created_by     String             @db.Uuid
  users          User               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_by], map: "idx_transactions_created_by")
  @@index([momo_reference], map: "idx_transactions_momo_reference")
  @@index([status], map: "idx_transactions_status")
  @@index([type], map: "idx_transactions_type")
  @@map("transactions")
}

model TontineGroup {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String          @db.VarChar(150)
  leader_user_id       String          @db.Uuid
  leader_phone         String          @db.VarChar(20)
  member_count         Int             @default(1)
  monthly_contribution Decimal         @db.Decimal(15, 2)
  completed_cycles     Int             @default(0)
  status               tontine_status  @default(PENDING)
  tontine_cycles       TontineCycle[]
  borrowers            Borrower        @relation(fields: [leader_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tontine_members      TontineMember[]

  @@index([status], map: "idx_tontine_groups_status")
  @@map("tontine_groups")
}

model TontineMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id       String       @db.Uuid
  borrower_id    String       @db.Uuid
  joined_at      DateTime     @default(now()) @db.Timestamp(6)
  borrowers      Borrower     @relation(fields: [borrower_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tontine_groups TontineGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, borrower_id])
  @@map("tontine_members")
}

model TontineCycle {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id          String       @db.Uuid
  cycle_number      Int
  start_date        DateTime     @db.Date
  end_date          DateTime     @db.Date
  total_collected   Decimal      @default(0.00) @db.Decimal(15, 2)
  is_complete       Boolean      @default(false)
  beneficiary_id    String       @db.Uuid
  members_paid      Int          @default(0)
  members_defaulted Int          @default(0)
  borrowers         Borrower     @relation(fields: [beneficiary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tontine_groups    TontineGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, cycle_number])
  @@index([group_id], map: "idx_tontine_cycles_group_id")
  @@map("tontine_cycles")
}

model GuaranteeFund {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  total_capital              Decimal                   @default(0.00) @db.Decimal(15, 2)
  active_portfolio_value     Decimal                   @default(0.00) @db.Decimal(15, 2)
  coverage_ratio             Decimal                   @default(0.00) @db.Decimal(5, 4)
  min_threshold              Decimal                   @default(0.0300) @db.Decimal(5, 4)
  target_threshold           Decimal                   @default(0.0500) @db.Decimal(5, 4)
  suspension_active          Boolean                   @default(false)
  last_reconstitution_date   DateTime?                 @db.Date
  guarantee_fund_investments GuaranteeFundInvestment[]

  @@map("guarantee_fund")
}

model GuaranteeFundInvestment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fund_id        String        @db.Uuid
  investment_id  String        @db.Uuid
  covered_amount Decimal       @db.Decimal(15, 2)
  activated_at   DateTime?     @db.Timestamp(6)
  is_activated   Boolean       @default(false)
  guarantee_fund GuaranteeFund @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  investments    Investment    @relation(fields: [investment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fund_id, investment_id])
  @@map("guarantee_fund_investments")
}

model ScoringEngine {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  momo_weight         Decimal @default(0.40) @db.Decimal(3, 2)
  tontine_weight      Decimal @default(0.35) @db.Decimal(3, 2)
  imf_weight          Decimal @default(0.25) @db.Decimal(3, 2)
  warning_signal_days Int     @default(45)

  @@map("scoring_engine")
}

model BorrowerScore {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  borrower_id   String   @db.Uuid
  momo_score    Decimal  @db.Decimal(5, 2)
  tontine_score Decimal  @db.Decimal(5, 2)
  imf_score     Decimal  @db.Decimal(5, 2)
  hybrid_score  Decimal  @db.Decimal(5, 2)
  computed_at   DateTime @default(now()) @db.Timestamp(6)
  borrowers     Borrower @relation(fields: [borrower_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("borrower_scores")
}

