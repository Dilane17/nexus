# Base de données
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexus_db"

# JWT
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=3000
NODE_ENV=development

# MoMo (FedaPay)
FEDAPAY_SECRET_KEY="your_fedapay_secret_key"
FEDAPAY_PUBLIC_KEY="your_fedapay_public_key"

# MoMo (KKiaPay)
KKIAPAY_PUBLIC_KEY="your_kkiapay_public_key"
KKIAPAY_SECRET_KEY="your_kkiapay_secret_key"

# IMF Sandbox
IMF_SANDBOX_URL="http://localhost:3001/imf-sandbox"
IMF_SANDBOX_TOKEN="sandbox_token_2025"
