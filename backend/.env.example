# ─────────────────────────────────────────────────────────────────────────────
# Nexus P2P Lending — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://nexus_user:password@localhost:5432/nexus_db"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_SECRET="change-me-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-different-from-jwt-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:8081"
FRONTEND_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:3000"
PAYMENT_RETURN_URL="http://localhost:8081/wallet?status=success"
PAYMENT_FAILURE_URL="http://localhost:8081/wallet?status=failed"
STATIC_UPLOADS_ENABLED="true"
UPLOAD_DIR="uploads"
FILES_PUBLIC_BASE_URL="http://localhost:3000"

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_ENABLED="true"
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="nexus:"

# ── Mobile Money — FedaPay ────────────────────────────────────────────────────
FEDAPAY_API_BASE_URL="https://sandbox-api.fedapay.com/v1"
FEDAPAY_SECRET_KEY="sk_sandbox_xxxxx"
FEDAPAY_PUBLIC_KEY="pk_sandbox_xxxxx"
FEDAPAY_WEBHOOK_SECRET="wh_sandbox_xxxxx"

# ── Mobile Money — KKiaPay ───────────────────────────────────────────────────
KKIAPAY_API_BASE_URL="https://api-sandbox.kkiapay.me"
KKIAPAY_WIDGET_BASE_URL="https://cdn.kkiapay.me"
KKIAPAY_PUBLIC_KEY="xxxxx"
KKIAPAY_SECRET_KEY="xxxxx"
KKIAPAY_WEBHOOK_SECRET="xxxxx"
PAYMENT_GATEWAY_MTN_MOMO="FEDAPAY"
PAYMENT_GATEWAY_MOOV_FLOOZ="KKIAPAY"

# ── Africa's Talking SMS ──────────────────────────────────────────────────────
AFRICASTALKING_SMS_BASE_URL="https://api.sandbox.africastalking.com/version1/messaging"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="atsk_xxxxx"
AFRICASTALKING_SENDER_ID="NEXUS"
AFRICASTALKING_SMS_RETRY_ATTEMPTS=3
AFRICASTALKING_SMS_RETRY_DELAY_MS=500

# ── IMF Sandbox ───────────────────────────────────────────────────────────────
IMF_SANDBOX_URL="http://localhost:3001/imf-sandbox"
IMF_SANDBOX_TOKEN="sandbox_token_dev"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# ── SMTP (Nodemailer) ─────────────────────────────────────────────────────────
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="votre.email@gmail.com"
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_FROM="Nexus P2P Lending <votre.email@gmail.com>"

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
