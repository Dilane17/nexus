{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@app/(.*)": "<rootDir>/../src/$1",
    "@shared/(.*)": "<rootDir>/../src/shared/$1",
    "@modules/(.*)": "<rootDir>/../src/modules/$1",
    "@generated/(.*)": "<rootDir>/../src/generated/$1"
  }
}
